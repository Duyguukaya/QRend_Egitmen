@{
    ViewData["Title"] = "Giriş";
    Layout = "_Layout";
}

<div class="min-h-screen flex items-center justify-center p-4 relative"
     style="background:linear-gradient(160deg,#0f2744 0%,#0d3d2e 100%)">

    <!-- Bg deco -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full opacity-10"
             style="background:radial-gradient(circle,#2563eb,transparent)"></div>
        <div class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full opacity-10"
             style="background:radial-gradient(circle,#10b981,transparent)"></div>
    </div>

    <div class="relative w-full max-w-md">
        <!-- Logo -->
        <div class="text-center mb-10">
            <div class="flex items-center justify-center gap-3 mb-3">
                <div class="w-14 h-14 rounded-2xl flex items-center justify-center shadow-2xl"
                     style="background:linear-gradient(135deg,#2563eb,#10b981)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="none"
                         viewBox="0 0 24 24" stroke="white" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                        <rect x="3" y="14" width="3" height="3" />
                    </svg>
                </div>
            </div>
            <h1 class="text-white font-extrabold tracking-widest" style="font-size:2rem">QRend</h1>
            <p class="text-slate-400 mt-1" style="font-size:0.875rem">Eğitmen Paneline Giriş Yapın</p>
        </div>

        <!-- Card -->
        <div class="rounded-2xl p-8 shadow-2xl"
             style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);backdrop-filter:blur(12px)">

            <form method="post" action="/Account/Login" class="flex flex-col gap-5">
                @Html.AntiForgeryToken()

                <div class="flex flex-col gap-2">
                    <label class="text-slate-300" style="font-size:0.8rem;font-weight:500">E-posta</label>
                    <input type="email" name="email" placeholder="ornek@qrend.app" required
                           class="w-full px-4 py-3 rounded-xl text-white outline-none transition-all"
                           style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);font-size:0.875rem;color:white"
                           onfocus="this.style.border='1px solid rgba(37,99,235,0.6)'"
                           onblur="this.style.border='1px solid rgba(255,255,255,0.12)'" />
                </div>

                <div class="flex flex-col gap-2">
                    <label class="text-slate-300" style="font-size:0.8rem;font-weight:500">Şifre</label>
                    <div class="relative">
                        <input type="password" name="password" id="passwordInput"
                               placeholder="••••••••" required
                               class="w-full px-4 py-3 pr-12 rounded-xl text-white outline-none transition-all"
                               style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);font-size:0.875rem"
                               onfocus="this.style.border='1px solid rgba(37,99,235,0.6)'"
                               onblur="this.style.border='1px solid rgba(255,255,255,0.12)'" />
                        <button type="button" onclick="togglePassword()"
                                class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-200 transition-colors">
                            <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        </button>
                    </div>
                </div>

                @if (ViewBag.Error != null)
                {
                    <p class="text-red-400 rounded-lg px-3 py-2"
                       style="font-size:0.8rem;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2)">
                        @ViewBag.Error
                    </p>
                }

                <button type="submit"
                        class="flex items-center justify-center gap-2 py-3 rounded-xl text-white transition-all duration-200 hover:opacity-90 active:scale-95 mt-2"
                        style="background:linear-gradient(135deg,#2563eb,#10b981);font-size:0.9rem;font-weight:600">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                    </svg>
                    Giriş Yap
                </button>
            </form>
        </div>

        <p class="text-center text-slate-500 mt-6" style="font-size:0.75rem">
            © 2026 QRend — QR Tabanlı Yoklama Sistemi
        </p>
    </div>
</div>

@section Scripts {
    <script>
        function togglePassword() {
          const input = document.getElementById('passwordInput');
          input.type = input.type === 'password' ? 'text' : 'password';
        }
    </script>
}