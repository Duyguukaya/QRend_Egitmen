@using QRend_Egitmen.Models
@model List<Lesson>
@{
    ViewData["Title"] = "Derslerim";
    Layout = "_Layout";
    int totalStudents = Model.Sum(l => l.StudentCount);
}

<div class="flex h-screen overflow-hidden" style="background:#f8fafc">

    @await Html.PartialAsync("_AppShell", "lessons")

    <main class="flex-1 overflow-y-auto p-8">

        <div class="mb-8">
            <h1 class="text-slate-800 font-bold" style="font-size:1.75rem">Derslerim</h1>
            <p class="text-slate-500 mt-1" style="font-size:0.875rem">Dr. Mehmet Çelik • Bilgisayar Mühendisliği</p>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-4 mb-8">

            <div class="rounded-2xl p-5" style="background:linear-gradient(135deg,#eff6ff,#dbeafe);border:1px solid #bfdbfe">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-3"
                     style="background:linear-gradient(135deg,#2563eb,#3b82f6)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none"
                         viewBox="0 0 24 24" stroke="white" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                </div>
                <p class="text-slate-500" style="font-size:0.75rem;font-weight:500">Toplam Ders</p>
                <p class="text-slate-800 font-bold mt-1" style="font-size:1.75rem">@Model.Count</p>
            </div>

            <div class="rounded-2xl p-5" style="background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:1px solid #bbf7d0">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-3"
                     style="background:linear-gradient(135deg,#059669,#10b981)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none"
                         viewBox="0 0 24 24" stroke="white" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </div>
                <p class="text-slate-500" style="font-size:0.75rem;font-weight:500">Toplam Öğrenci</p>
                <p class="text-slate-800 font-bold mt-1" style="font-size:1.75rem">@totalStudents</p>
            </div>

            <div class="rounded-2xl p-5" style="background:linear-gradient(135deg,#f0f9ff,#e0f2fe);border:1px solid #bae6fd">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-3"
                     style="background:linear-gradient(135deg,#0284c7,#38bdf8)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none"
                         viewBox="0 0 24 24" stroke="white" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <p class="text-slate-500" style="font-size:0.75rem;font-weight:500">Bu Hafta</p>
                <p class="text-slate-800 font-bold mt-1" style="font-size:1.75rem">@Model.Count</p>
            </div>

        </div>

        <!-- Table -->
        <div class="rounded-2xl overflow-hidden" style="border:1px solid #e2e8f0">

            <div class="px-6 py-4 flex items-center justify-between"
                 style="background:white;border-bottom:1px solid #e2e8f0">
                <h2 class="text-slate-700 font-semibold" style="font-size:0.95rem">Ders Listesi</h2>
                <span class="px-3 py-1 rounded-full text-blue-700 font-semibold"
                      style="background:#dbeafe;font-size:0.75rem">@Model.Count Ders</span>
            </div>

            <div style="background:white">

                <!-- Table Header -->
                <div class="grid px-6 py-3"
                     style="grid-template-columns:2fr 1fr 2fr 1fr 1fr;border-bottom:1px solid #f1f5f9;background:#f8fafc">
                    @foreach (var h in new[] { "Ders Adı", "Kod", "Ders Saati", "Öğrenci Sayısı", "İşlem" })
                    {
                        <span class="text-slate-500"
                              style="font-size:0.72rem;font-weight:600;text-transform:uppercase;letter-spacing:0.06em">@h</span>
                    }
                </div>

                <!-- Table Rows -->
                @for (int i = 0; i < Model.Count; i++)
                {
                    var lesson = Model[i];
                    string rowBorder = i < Model.Count - 1 ? "border-bottom:1px solid #f1f5f9" : "";

                    <div class="grid px-6 py-4 items-center hover:bg-slate-50 transition-colors"
                         style="grid-template-columns:2fr 1fr 2fr 1fr 1fr;@rowBorder">

                        <!-- Ders Adı -->
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0"
                                 style="background:linear-gradient(135deg,#dbeafe,#bbf7d0)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"
                                     viewBox="0 0 24 24" stroke="#2563eb" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                </svg>
                            </div>
                            <span class="text-slate-700" style="font-size:0.875rem;font-weight:500">@lesson.Name</span>
                        </div>

                        <!-- Kod -->
                        <span class="px-2.5 py-1 rounded-lg text-blue-700 inline-block w-fit font-semibold"
                              style="background:#eff6ff;font-size:0.78rem;border:1px solid #bfdbfe">@lesson.Code</span>

                        <!-- Schedule -->
                        <div class="flex items-center gap-2 text-slate-500">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span style="font-size:0.82rem">@lesson.Schedule</span>
                        </div>

                        <!-- Öğrenci Sayısı -->
                        <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl w-fit"
                             style="background:#f0fdf4;border:1px solid #bbf7d0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none"
                                 viewBox="0 0 24 24" stroke="#059669" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <span class="text-emerald-700 font-semibold" style="font-size:0.82rem">@lesson.StudentCount</span>
                        </div>

                        <!-- İşlem -->
                        <a href="/Attendance/Index?lessonId=@lesson.Id"
                           class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-blue-600 hover:text-blue-700 hover:bg-blue-50 transition-all w-fit"
                           style="font-size:0.8rem;font-weight:500;border:1px solid #bfdbfe">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="7" height="7" />
                                <rect x="14" y="3" width="7" height="7" />
                                <rect x="14" y="14" width="7" height="7" />
                            </svg>
                            Yoklama Al
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                            </svg>
                        </a>

                    </div>
                }

            </div>
        </div>

    </main>
</div>