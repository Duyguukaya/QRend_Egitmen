@model string

<aside class="w-64 flex flex-col shrink-0"
       style="background:linear-gradient(160deg,#0f2744 0%,#0d3d2e 100%)">

    <!-- Logo -->
    <div class="flex items-center gap-3 px-6 py-6" style="border-bottom:1px solid rgba(255,255,255,0.1)">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center shadow-lg"
             style="background:linear-gradient(135deg,#2563eb,#10b981)">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none"
                 viewBox="0 0 24 24" stroke="white" stroke-width="2">
                <rect x="3" y="3" width="7" height="7" />
                <rect x="14" y="3" width="7" height="7" />
                <rect x="14" y="14" width="7" height="7" />
                <rect x="3" y="14" width="3" height="3" />
                <rect x="8" y="14" width="3" height="3" />
                <rect x="3" y="19" width="3" height="3" />
                <rect x="8" y="19" width="3" height="3" />
            </svg>
        </div>
        <div>
            <span class="text-white font-bold tracking-wide" style="font-size:1.35rem">QRend</span>
            <p class="text-blue-300" style="font-size:0.7rem;opacity:0.7">Eğitmen Paneli</p>
        </div>
    </div>

    <!-- Instructor Info -->
    <div class="px-6 py-5" style="border-bottom:1px solid rgba(255,255,255,0.1)">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full flex items-center justify-center text-white shrink-0 font-bold"
                 style="background:linear-gradient(135deg,#2563eb,#10b981);font-size:0.8rem">
                MC
            </div>
            <div class="overflow-hidden">
                <p class="text-white font-semibold truncate" style="font-size:0.85rem">Dr. Mehmet Çelik</p>
                <p class="text-slate-400 truncate" style="font-size:0.7rem">Bilgisayar Mühendisliği</p>
            </div>
        </div>
    </div>

    <!-- Nav -->
    <nav class="flex-1 px-4 py-6 flex flex-col gap-1">
        @{
            bool lessonsActive = Model == "lessons";
            bool attendanceActive = Model == "attendance";
        }

        <a href="/Lessons"
           class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200"
           style="@(lessonsActive ? "background:linear-gradient(135deg,rgba(37,99,235,0.35),rgba(16,185,129,0.25));border:1px solid rgba(37,99,235,0.3);color:white" : "color:#94a3b8")">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none"
                 viewBox="0 0 24 24" stroke="@(lessonsActive ? "#34d399" : "currentColor")" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            <span style="font-size:0.875rem;font-weight:@(lessonsActive ? "600" : "400")">Derslerim</span>
            @if (lessonsActive)
            {
                <div class="ml-auto w-1.5 h-1.5 rounded-full" style="background:#34d399"></div>
            }
        </a>

        <a href="/Attendance"
           class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200"
           style="@(attendanceActive ? "background:linear-gradient(135deg,rgba(37,99,235,0.35),rgba(16,185,129,0.25));border:1px solid rgba(37,99,235,0.3);color:white" : "color:#94a3b8")">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none"
                 viewBox="0 0 24 24" stroke="@(attendanceActive ? "#34d399" : "currentColor")" stroke-width="2">
                <rect x="3" y="3" width="7" height="7" />
                <rect x="14" y="3" width="7" height="7" />
                <rect x="14" y="14" width="7" height="7" />
                <rect x="3" y="14" width="3" height="3" />
            </svg>
            <span style="font-size:0.875rem;font-weight:@(attendanceActive ? "600" : "400")">Yoklama Al</span>
            @if (attendanceActive)
            {
                <div class="ml-auto w-1.5 h-1.5 rounded-full" style="background:#34d399"></div>
            }
        </a>
    </nav>

    <!-- Logout -->
    <div class="px-4 pb-6">
        <a href="/Account/Logout"
           class="w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200"
           style="color:#94a3b8">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            <span style="font-size:0.875rem">Çıkış Yap</span>
        </a>
    </div>

</aside>