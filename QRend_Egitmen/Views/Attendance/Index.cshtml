@using QRend_Egitmen.Models
@{
    ViewData["Title"] = "Yoklama Al";
    Layout = "_Layout";
    var lessons = ViewBag.Lessons as List<Lesson> ?? new List<Lesson>();
    var selectedId = ViewBag.SelectedLessonId as string ?? "";
    var session = ViewBag.ActiveSession as AttendanceSession;
    var history = ViewBag.AttendanceHistory as List<AttendanceRecord> ?? new List<AttendanceRecord>();
    var selectedLesson = lessons.FirstOrDefault(l => l.Id == selectedId);
    bool isActive = session?.IsActive == true;
    int joinedCount = session?.JoinedStudents?.Count ?? 0;
    string bannerBg = joinedCount > 0 ? "linear-gradient(135deg,#f0fdf4,#eff6ff)" : "#f8fafc";
    string bannerBorder = joinedCount > 0 ? "#bbf7d0" : "#e2e8f0";
    string countColor = joinedCount > 0 ? "#059669" : "#94a3b8";
    string labelColor = joinedCount > 0 ? "#16a34a" : "#94a3b8";
}

<div class="flex h-screen overflow-hidden" style="background:#f8fafc">

  @await Html.PartialAsync("_AppShell", "attendance")

  <main class="flex-1 overflow-y-auto p-8">

    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-slate-800 font-bold" style="font-size:1.75rem">Yoklama Al</h1>
        <p class="text-slate-500 mt-1" style="font-size:0.875rem">QR kod ile anlık yoklama başlatın</p>
      </div>
      @if (isActive)
      {
        <button onclick="document.getElementById('modalOverlay').classList.remove('hidden')"
                class="flex items-center gap-2 px-5 py-2.5 rounded-xl text-white"
                style="background:linear-gradient(135deg,#2563eb,#10b981);font-size:0.875rem;font-weight:600">
          Manuel Öğrenci Ekle
        </button>
      }
      else
      {
        <button disabled
                class="flex items-center gap-2 px-5 py-2.5 rounded-xl text-white"
                style="background:#cbd5e1;font-size:0.875rem;font-weight:600;opacity:0.6;cursor:not-allowed">
          Manuel Öğrenci Ekle
        </button>
      }
    </div>

    <!-- Lesson Selector -->
    @if (!isActive)
    {
      <div class="rounded-2xl p-6 mb-6" style="background:white;border:1px solid #e2e8f0">
        <p class="text-slate-600 mb-3" style="font-size:0.82rem;font-weight:500">Yoklama alacağınız dersi seçin</p>
        <form method="get" action="/Attendance/Index">
          <div class="relative">
            <select name="lessonId" onchange="this.form.submit()"
                    class="w-full px-4 py-3 rounded-xl outline-none appearance-none cursor-pointer"
                    style="background:#f8fafc;border:1px solid #e2e8f0;font-size:0.9rem;color:#1e293b;font-weight:500">
              @foreach (var l in lessons)
              {
                if (l.Id == selectedId)
                {
                  <option value="@l.Id" selected="selected">@l.Name (@l.Code) — @l.StudentCount öğrenci</option>
                }
                else
                {
                  <option value="@l.Id">@l.Name (@l.Code) — @l.StudentCount öğrenci</option>
                }
              }
            </select>
            <svg class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400"
                 xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </div>
        </form>
      </div>
    }

    <!-- Active Session Banner -->
    @if (isActive)
    {
      <div class="rounded-2xl p-4 mb-6 flex items-center gap-4"
           style="background:linear-gradient(135deg,#f0fdf4,#eff6ff);border:1px solid #bbf7d0">
        <div class="w-2 h-2 rounded-full animate-pulse" style="background:#10b981"></div>
        <div>
          <p class="text-emerald-800 font-semibold" style="font-size:0.82rem">
            Yoklama Aktif — @selectedLesson?.Name (@selectedLesson?.Code)
          </p>
          <p class="text-emerald-600" style="font-size:0.75rem">
            Başlangıç: @session!.StartedAt • Oturum: @session.SessionId
          </p>
        </div>
      </div>
    }

    <!-- QR + Student List -->
    <div class="grid gap-6 mb-8" style="grid-template-columns:3fr 2fr">

      <!-- QR Area -->
      <div class="rounded-2xl overflow-hidden" style="background:white;border:1px solid #e2e8f0">
        <div class="px-6 py-4 flex items-center justify-between" style="border-bottom:1px solid #f1f5f9">
          <h2 class="text-slate-700 font-semibold" style="font-size:0.95rem">QR Kod</h2>
          @if (isActive)
          {
            <span class="text-blue-600" style="font-size:0.75rem;font-weight:500">
              <span id="countdownText">10</span>s'de yenileniyor
            </span>
          }
        </div>

        <div class="p-10 flex flex-col items-center">
          @if (isActive)
          {
            var qrToken = ViewBag.SessionToken as string ?? session!.SessionId;
            var apiSessionId = ViewBag.ApiSessionId;
            var qrUrl = "https://api.qrserver.com/v1/create-qr-code/?size=220x220&color=0f2744&data=" + Uri.EscapeDataString(qrToken);

            <div class="p-5 rounded-2xl shadow-lg mb-5" style="background:white;border:2px solid #e2e8f0">
              <img id="qrImage" src="@qrUrl" width="220" height="220" alt="QR Kod"/>
            </div>

            <div class="w-full max-w-xs mb-5">
              <div class="flex items-center justify-between mb-2">
                <span class="text-slate-500" style="font-size:0.72rem">Yenileniyor</span>
                <span class="text-blue-600 font-bold" id="countdownBadge" style="font-size:0.75rem">10s</span>
              </div>
              <div class="w-full h-2 rounded-full overflow-hidden" style="background:#e2e8f0">
                <div id="countdownBar" class="h-full rounded-full"
                     style="width:100%;background:linear-gradient(90deg,#2563eb,#10b981);transition:width 0.5s linear"></div>
              </div>
            </div>

            <p class="text-slate-500 text-center mb-6" style="font-size:0.8rem">
              Öğrenciler bu kodu telefon kameralarıyla tarayarak yoklamaya katılabilir.<br/>
              QR kod her <strong>10 saniyede bir</strong> otomatik yenilenir.
            </p>

            <form method="post" action="/Attendance/Stop">
              @Html.AntiForgeryToken()
              <input type="hidden" name="apiSessionId" value="@apiSessionId"/>
              <input type="hidden" name="lessonId" value="@selectedId"/>
              <button type="submit"
                      class="flex items-center gap-2 px-6 py-3 rounded-xl text-red-600 hover:bg-red-50 transition-all"
                      style="border:1.5px solid #fca5a5;font-size:0.875rem;font-weight:600">
                Yoklamayı Bitir
              </button>
            </form>
          }
          else
          {
            <div class="w-56 h-56 rounded-2xl flex flex-col items-center justify-center mb-8"
                 style="background:#f8fafc;border:2px dashed #cbd5e1">
              <p class="text-slate-400 text-center" style="font-size:0.8rem">
                QR kod burada<br/>görünecek
              </p>
            </div>

            <p class="text-slate-500 text-center mb-8" style="font-size:0.85rem">
              Yoklamayı başlatmak için aşağıdaki butona basın.<br/>
              <span class="text-slate-400" style="font-size:0.78rem">QR kod her 10 saniyede bir otomatik yenilenir.</span>
            </p>

            <form method="post" action="/Attendance/Start">
              @Html.AntiForgeryToken()
              <input type="hidden" name="lessonId" value="@selectedId"/>
              <button type="submit"
                      class="flex items-center gap-2 px-8 py-3.5 rounded-xl text-white hover:opacity-90 transition-all"
                      style="background:linear-gradient(135deg,#2563eb,#10b981);font-size:0.9rem;font-weight:700;box-shadow:0 4px 20px rgba(37,99,235,0.3)">
                Yoklamayı Başlat
              </button>
            </form>
          }
        </div>
      </div>

      <!-- Student List -->
      <div class="rounded-2xl overflow-hidden flex flex-col" style="background:white;border:1px solid #e2e8f0">
        <div class="px-5 py-4 flex items-center justify-between" style="border-bottom:1px solid #f1f5f9">
          <h2 class="text-slate-700 font-semibold" style="font-size:0.95rem">Katılanlar</h2>
          <div class="px-2.5 py-1 rounded-xl" style="background:#f0fdf4;border:1px solid #bbf7d0">
            <span class="text-emerald-700 font-bold" style="font-size:0.78rem">@joinedCount</span>
          </div>
        </div>

        <div class="mx-4 mt-4 mb-3 rounded-xl py-3 text-center"
             style="background:@bannerBg;border:1px solid @bannerBorder">
          <span style="font-size:1.4rem;font-weight:800;color:@countColor">@joinedCount</span>
          <p style="font-size:0.72rem;font-weight:500;color:@labelColor">öğrenci yoklamaya katıldı</p>
        </div>

        <div class="flex-1 overflow-y-auto px-4 pb-4 flex flex-col gap-1.5">
          @if (joinedCount > 0 && session?.JoinedStudents != null)
          {
            for (int i = 0; i < session.JoinedStudents.Count; i++)
            {
              var s = session.JoinedStudents[i];
              int num = i + 1;
              <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl"
                   style="background:#f8fafc;border:1px solid #f1f5f9">
                <div class="w-8 h-8 rounded-xl flex items-center justify-center text-white shrink-0 font-bold"
                     style="background:linear-gradient(135deg,#2563eb,#10b981);font-size:0.65rem">@num</div>
                <div class="flex-1 overflow-hidden">
                  <p class="text-slate-700 truncate font-medium" style="font-size:0.82rem">@s.Name</p>
                  <p class="text-slate-400 truncate" style="font-size:0.7rem">@s.StudentNo</p>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none"
                     viewBox="0 0 24 24" stroke="#10b981" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round"
                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
            }
          }
          else
          {
            <div class="flex flex-col items-center justify-center flex-1 py-10">
              <p class="text-slate-400 text-center" style="font-size:0.8rem">
                Henüz katılan yok.<br/>
                <span style="font-size:0.72rem">Yoklamayı başlatın.</span>
              </p>
            </div>
          }
        </div>
      </div>
    </div>

    <!-- Geçmiş Yoklama Kayıtları -->
    @if (history.Count > 0)
    {
      <div class="rounded-2xl overflow-hidden" style="border:1px solid #e2e8f0">
        <div class="px-6 py-4 flex items-center justify-between"
             style="background:white;border-bottom:1px solid #e2e8f0">
          <h2 class="text-slate-700 font-semibold" style="font-size:0.95rem">Geçmiş Yoklamalar</h2>
          <span class="px-3 py-1 rounded-full font-semibold"
                style="background:#f1f5f9;color:#64748b;font-size:0.75rem">@history.Count Oturum</span>
        </div>

        <div style="background:white">
          @foreach (var record in history)
          {
            <!-- Kayıt Satırı -->
            <div class="border-b last:border-0" style="border-color:#f1f5f9">

              <!-- Başlık satırı (tıklanabilir accordion) -->
              <button onclick="toggleRecord('@record.SessionId')"
                      class="w-full flex items-center justify-between px-6 py-4 hover:bg-slate-50 transition-colors text-left">
                <div class="flex items-center gap-4">
                  <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0"
                       style="background:linear-gradient(135deg,#eff6ff,#dcfce7);border:1px solid #bfdbfe">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"
                         viewBox="0 0 24 24" stroke="#2563eb" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round"
                            d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-slate-700 font-semibold" style="font-size:0.875rem">
                      @record.LessonName
                      <span class="ml-2 px-2 py-0.5 rounded-md text-blue-700 font-semibold"
                            style="background:#eff6ff;font-size:0.72rem;border:1px solid #bfdbfe">@record.LessonCode</span>
                    </p>
                    <p class="text-slate-400" style="font-size:0.75rem">
                      @record.Date • @record.StartedAt – @record.EndedAt • @record.SessionId
                    </p>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl"
                       style="background:#f0fdf4;border:1px solid #bbf7d0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none"
                         viewBox="0 0 24 24" stroke="#059669" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round"
                            d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span class="text-emerald-700 font-bold" style="font-size:0.82rem">@record.JoinedStudents.Count öğrenci</span>
                  </div>
                  <svg id="chevron-@record.SessionId" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"
                       viewBox="0 0 24 24" stroke="#94a3b8" stroke-width="2"
                       style="transition:transform 0.2s">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                  </svg>
                </div>
              </button>

              <!-- Öğrenci listesi (gizli/açık) -->
              <div id="record-@record.SessionId" style="display:none">
                @if (record.JoinedStudents.Count == 0)
                {
                  <div class="px-6 py-4 text-slate-400" style="font-size:0.82rem">
                    Bu oturumda yoklamaya katılan öğrenci yok.
                  </div>
                }
                else
                {
                  <div class="px-6 pb-4">
                    <div class="rounded-xl overflow-hidden" style="border:1px solid #f1f5f9">
                      <!-- Mini tablo header -->
                      <div class="grid px-4 py-2" style="grid-template-columns:2rem 1fr 1fr 1fr;background:#f8fafc;border-bottom:1px solid #f1f5f9">
                        <span class="text-slate-400" style="font-size:0.7rem;font-weight:600">#</span>
                        <span class="text-slate-400" style="font-size:0.7rem;font-weight:600;text-transform:uppercase">Ad Soyad</span>
                        <span class="text-slate-400" style="font-size:0.7rem;font-weight:600;text-transform:uppercase">Öğrenci No</span>
                        <span class="text-slate-400" style="font-size:0.7rem;font-weight:600;text-transform:uppercase">Katılım Saati</span>
                      </div>
                      @for (int i = 0; i < record.JoinedStudents.Count; i++)
                      {
                        var s = record.JoinedStudents[i];
                        int num = i + 1;
                        string rowStyle = i % 2 == 0 ? "background:white" : "background:#f8fafc";
                        <div class="grid px-4 py-2.5 items-center" style="grid-template-columns:2rem 1fr 1fr 1fr;@rowStyle">
                          <span class="text-slate-400 font-medium" style="font-size:0.78rem">@num</span>
                          <span class="text-slate-700 font-medium" style="font-size:0.82rem">@s.Name</span>
                          <span class="text-slate-500" style="font-size:0.78rem">@s.StudentNo</span>
                          <span class="text-emerald-600 font-medium" style="font-size:0.78rem">@(s.JoinedAt ?? "-")</span>
                        </div>
                      }
                    </div>
                  </div>
                }
              </div>

            </div>
          }
        </div>
      </div>
    }

    <!-- Manuel Öğrenci Ekleme Modal -->
    <div id="modalOverlay" class="fixed inset-0 z-50 hidden items-center justify-center p-4"
         style="background:rgba(0,0,0,0.5);backdrop-filter:blur(4px)">
      <div class="w-full max-w-md rounded-2xl shadow-2xl overflow-hidden" style="background:white">
        <div class="px-6 py-5 flex items-center justify-between"
             style="background:linear-gradient(135deg,#0f2744,#0d3d2e);border-bottom:1px solid rgba(255,255,255,0.1)">
          <div>
            <h3 class="text-white font-semibold" style="font-size:0.95rem">Öğrenci Ekle</h3>
            <p class="text-slate-400" style="font-size:0.72rem">Yoklamaya manuel olarak öğrenci ekle</p>
          </div>
          <button onclick="document.getElementById('modalOverlay').classList.add('hidden')"
                  class="text-slate-400 hover:text-white transition-colors text-xl font-bold">x</button>
        </div>

        <div class="flex border-b border-slate-100" style="background:#f8fafc">
          <button onclick="switchTab('search')" id="tabSearch"
                  class="flex-1 py-3"
                  style="font-size:0.82rem;font-weight:600;color:#2563eb;border-bottom:2px solid #2563eb;background:transparent">
            Listeden Seç
          </button>
          <button onclick="switchTab('manual')" id="tabManual"
                  class="flex-1 py-3"
                  style="font-size:0.82rem;font-weight:400;color:#94a3b8;border-bottom:2px solid transparent;background:transparent">
            Manuel Ekle
          </button>
        </div>

        <div id="tabContentSearch" class="p-6 flex flex-col gap-3">
          <input id="studentSearch" type="text" placeholder="İsim veya öğrenci no ile ara..."
                 onkeyup="filterStudents()"
                 class="w-full px-4 py-2.5 rounded-xl outline-none"
                 style="background:#f1f5f9;border:1px solid #e2e8f0;font-size:0.85rem;color:#1e293b"/>
          <div class="rounded-xl overflow-auto flex flex-col"
               style="border:1px solid #e2e8f0;max-height:260px" id="studentList">
            @if (selectedLesson != null)
            {
              foreach (var s in selectedLesson.Students.Take(20))
              {
                <form method="post" action="/Attendance/AddStudent">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="studentId" value="@s.Id"/>
                  <button type="submit"
                          class="student-row w-full flex items-center justify-between px-4 py-3 hover:bg-blue-50 transition-colors text-left"
                          style="border-bottom:1px solid #f8fafc"
                          data-name="@s.Name.ToLower()" data-no="@s.StudentNo">
                    <div>
                      <p class="text-slate-700 font-medium" style="font-size:0.85rem">@s.Name</p>
                      <p class="text-slate-400" style="font-size:0.75rem">@s.StudentNo</p>
                    </div>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none"
                         viewBox="0 0 24 24" stroke="#10b981" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round"
                            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  </button>
                </form>
              }
            }
          </div>
        </div>

        <div id="tabContentManual" class="p-6 flex-col gap-4" style="display:none">
          <form method="post" action="/Attendance/AddStudent" class="flex flex-col gap-4">
            @Html.AntiForgeryToken()
            <div class="flex flex-col gap-1.5">
              <label class="text-slate-600" style="font-size:0.8rem;font-weight:500">Ad Soyad</label>
              <input type="text" name="manualName" placeholder="Öğrenci adını girin"
                     class="w-full px-4 py-2.5 rounded-xl outline-none"
                     style="background:#f1f5f9;border:1px solid #e2e8f0;font-size:0.85rem;color:#1e293b"/>
            </div>
            <div class="flex flex-col gap-1.5">
              <label class="text-slate-600" style="font-size:0.8rem;font-weight:500">Öğrenci Numarası</label>
              <input type="text" name="manualNo" placeholder="Öğrenci numarasını girin"
                     class="w-full px-4 py-2.5 rounded-xl outline-none"
                     style="background:#f1f5f9;border:1px solid #e2e8f0;font-size:0.85rem;color:#1e293b"/>
            </div>
            <button type="submit"
                    class="flex items-center justify-center gap-2 py-3 rounded-xl text-white"
                    style="background:linear-gradient(135deg,#2563eb,#10b981);font-size:0.875rem;font-weight:600">
              Öğrenciyi Ekle
            </button>
          </form>
        </div>
      </div>
    </div>

  </main>
</div>

@section Scripts {
<script>
function switchTab(tab) {
  var isSearch = tab === 'search';
  document.getElementById('tabContentSearch').style.display = isSearch ? 'flex' : 'none';
  document.getElementById('tabContentManual').style.display = isSearch ? 'none' : 'flex';
  document.getElementById('tabSearch').style.color = isSearch ? '#2563eb' : '#94a3b8';
  document.getElementById('tabSearch').style.borderBottom = isSearch ? '2px solid #2563eb' : '2px solid transparent';
  document.getElementById('tabSearch').style.fontWeight = isSearch ? '600' : '400';
  document.getElementById('tabManual').style.color = !isSearch ? '#2563eb' : '#94a3b8';
  document.getElementById('tabManual').style.borderBottom = !isSearch ? '2px solid #2563eb' : '2px solid transparent';
  document.getElementById('tabManual').style.fontWeight = !isSearch ? '600' : '400';
}

function filterStudents() {
  var q = document.getElementById('studentSearch').value.toLowerCase();
  document.querySelectorAll('.student-row').forEach(function(row) {
    var match = row.dataset.name.includes(q) || row.dataset.no.includes(q);
    row.parentElement.style.display = match ? '' : 'none';
  });
}

function toggleRecord(sessionId) {
  var panel = document.getElementById('record-' + sessionId);
  var chevron = document.getElementById('chevron-' + sessionId);
  var isOpen = panel.style.display !== 'none';
  panel.style.display = isOpen ? 'none' : 'block';
  chevron.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
}

var sessionActive = @(isActive ? "true" : "false");
if (sessionActive) {
  var countdown = 10;
  var bar = document.getElementById('countdownBar');
  var badge = document.getElementById('countdownBadge');
  var txt = document.getElementById('countdownText');
  setInterval(function() {
    countdown--;
    if (countdown <= 0) {
      location.reload();
      return;
    }
    var pct = (countdown / 10) * 100;
    if (bar) bar.style.width = pct + '%';
    if (badge) badge.textContent = countdown + 's';
    if (txt) txt.textContent = countdown;
  }, 1000);
}
</script>
}